{
  "name": "retry-simulator",
  "version": "1.1.8",
  "description": "A lightweight TypeScript utility for retrying async functions with configurable backoff strategies like fixed, linear,and exponential retries.",
  "main": "index.js",
  "type": "module",
  "homepage": "https://github.com/krish-patel-simform/retry-simulator#readme",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "dev": "tsup src/index.ts --watch"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "network",
    "retry",
    "backoff",
    "simulation",
    "api",
    "testing",
    "frontend",
    "typescript",
    "developer-tools",
    "mock-network"
  ],
  "author": "Krish Patel",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^25.6.2",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  }
}
